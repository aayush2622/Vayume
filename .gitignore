result
result-*

# VM images
*.qcow2
*.img

# Secrets
*.key
*.pem
*.secret
secrets/
.env
.env.*

# A host's own directory is personal by default - real usernames, password
# hashes, disk UUIDs, avatar images, whatever else ends up in there. Deny
# everything, then explicitly allow just the files actually meant to be
# tracked, so a new personal file dropped in here doesn't need a new
# .gitignore line to stay untracked. _hardware.nix/_config.nix (required, see
# modules/hosts/Diablo/Host.nix) fall out of this automatically - copy the
# matching *.nix.example next to them and fill it in.
modules/hosts/*/*
!modules/hosts/*/Host.nix
!modules/hosts/*/Vm.nix
!modules/hosts/*/*.nix.example

# Optional local binary cache (see modules/lib/LoadOrBuild.nix) - a zip
# per package, dropped in by hand to skip an expensive from-source
# build (e.g. WPE WebKit). Large and machine-specific, never committed.
/bin/

# Editor files
.vscode/
.claude/
.idea/
*.swp