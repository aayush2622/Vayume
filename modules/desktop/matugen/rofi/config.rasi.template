configuration {
    modi: "combi,drun,filebrowser";
    combi-modi: "drun,window";
    combi-display-format: "{text}";
    show-icons: true;
    icon-theme: "VAYUME_ICON_THEME_TOKEN";
    font: "VAYUME_FONT_TOKEN 12";
    terminal: "kitty";
    matching: "fuzzy";
    sorting-method: "fzf";
    drun-display-format: "{name}\n<span size='small' alpha='60%'>{comment}</span>";
    window-format: "{c}  {t}";
    display-combi: "All";
    display-drun: "Apps";
    display-filebrowser: "Files";
    display-window: "Windows";
    kb-element-next: "";
    kb-element-prev: "";
    kb-row-tab: "";
    kb-mode-next: "Tab,Shift+Right,Control+Tab";
    kb-mode-previous: "ISO_Left_Tab,Shift+Left,Control+ISO_Left_Tab";
}

* {
    surface: {{colors.surface_container.default.hex}}f2;
    outline: {{colors.outline_variant.default.hex}};
    fg: {{colors.on_surface.default.hex}};
    muted: {{colors.on_surface_variant.default.hex}};
    accent: {{colors.primary.default.hex}};
    on-accent: {{colors.on_primary.default.hex}};
    sel-bg: {{colors.primary.default.hex}}2e;

    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 620px;
    background-color: @surface;
    border: 1px;
    border-color: @outline;
    border-radius: 26px;
}

mainbox {
    padding: 16px;
    spacing: 12px;
    children: [ "inputbar", "header", "listview", "footer" ];
}

inputbar,
header,
footer {
    expand: false;
}

inputbar {
    padding: 12px 18px;
    spacing: 12px;
    border: 2px;
    border-color: @accent;
    border-radius: 24px;
    children: [ "textbox-search-icon", "entry" ];
}

textbox-search-icon {
    expand: false;
    str: "search";
    font: "Material Symbols Rounded 20";
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Search applications, files...";
    placeholder-color: @muted;
    vertical-align: 0.5;
}

header {
    orientation: horizontal;
    padding: 2px 6px;
    spacing: 10px;
    children: [ "textbox-header-icon", "textbox-header-title", "num-filtered-rows" ];
}

textbox-header-icon {
    expand: false;
    str: "apps";
    font: "Material Symbols Rounded 16";
    text-color: @muted;
    vertical-align: 0.5;
}

textbox-header-title {
    expand: false;
    str: "Applications";
    font: "VAYUME_FONT_TOKEN Bold 11";
    vertical-align: 0.5;
}

num-filtered-rows {
    expand: false;
    text-color: @muted;
    font: "VAYUME_FONT_TOKEN 10";
    vertical-align: 0.5;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    cycle: true;
    spacing: 4px;
}

element {
    orientation: horizontal;
    padding: 8px 12px;
    spacing: 14px;
    border-radius: 20px;
}

element normal.normal,
element normal.active,
element normal.urgent,
element alternate.normal,
element alternate.active,
element alternate.urgent {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @sel-bg;
    text-color: @fg;
}

element-icon {
    size: 40px;
    vertical-align: 0.5;
}

element-text {
    markup: true;
    highlight: bold {{colors.primary.default.hex}};
    vertical-align: 0.5;
}

footer {
    orientation: horizontal;
    padding: 4px 0 0 0;
    spacing: 10px;
    children: [ "mode-switcher", "textbox-hints" ];
}

mode-switcher {
    expand: false;
    spacing: 6px;
}

button {
    expand: false;
    padding: 8px 16px;
    border-radius: 20px;
    background-color: transparent;
    text-color: @muted;
    vertical-align: 0.5;
}

button selected {
    background-color: @accent;
    text-color: @on-accent;
}

textbox-hints {
    expand: true;
    str: "↑↓ nav     ↵ open     ⇥ tabs";
    font: "VAYUME_FONT_TOKEN 10";
    text-color: @muted;
    horizontal-align: 1;
    vertical-align: 0.5;
}
